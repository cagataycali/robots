// strands-robots mesh ACL - operator template (role-scoped subscribe).
//
// Drop this at $STRANDS_MESH_ACL_FILE and edit the ENUMERATED CNs
// below to match the cert Common Names of every robot and operator
// in your fleet.
//
// SUBSCRIBE SCOPING
// -----------------
// This template is deny-by-default and scopes the subscribe surface by
// ROLE rather than handing every authenticated peer a blanket
// `declare_subscriber` on `**`:
//
//   * robot_peer  - may subscribe only to operationally low-impact,
//                   fleet-shared topic CLASSES (presence, broadcast,
//                   safety) plus its OWN command/response. It cannot
//                   declare a subscriber on another robot's cmd / state
//                   / camera / input topics. This mirrors the IoT
//                   transport's per-Thing subscribe isolation
//                   (provision.py AllowOwnSubscriptions / AllowReceiveScoped).
//   * operator_peer - retains broad observe privilege (`**`), because
//                   operators legitimately monitor the whole fleet. This
//                   is an INTENTIONAL operator-role grant, called out
//                   explicitly below so it is never mistaken for a robot
//                   grant.
//
// RESIDUAL LIMITATION (read before relying on this for hard isolation)
// --------------------------------------------------------------------
// Zenoh 1.x `key_exprs` cannot interpolate the connecting peer's cert
// CN, so a single `robot_peer` subject scoped by topic-CLASS still lets
// one robot subscribe to another robot's OWN-class topics if they share
// the topic shape (there is no `${cn}` substitution like IoT's
// `${iot:Connection.Thing.ThingName}`). For STRICT per-peer isolation
// equivalent to the IoT policy, enumerate one rule + one subject per
// robot CN - see examples/mesh/mesh_acl_strict_per_peer.json5. When in doubt,
// prefer the IoT transport for fleets that require hard cross-peer
// subscribe denial.
//
// Zenoh 1.x quirks (verified against live sessions in
// tests/mesh/test_zenoh_transport_security.py):
//
//  1. `enabled: true` is required. Without it the entire access_control
//     block is a silent no-op.
//
//  2. `cert_common_names` matches LITERAL CNs only - `"robot-*"` and
//     `"robot-.*"` both match nothing. Enumerate every peer by exact
//     CN below; there is no glob fallback.
//
//  3. Subject `interfaces` is OPTIONAL per Zenoh's schema
//     (Option<NEVec<...>>; an absent field maps to
//     SubjectProperty::Wildcard, i.e. matches every link). We omit
//     it below so this template works on any host regardless of NIC
//     name (`eth0` / `enp0s3` / `cni0` / `wg0` / ...). Add an
//     `interfaces: ["lo", "eth0", ...]` line under a subject if you
//     want to additionally scope it to a NIC subset.
//
//  4. `key_exprs` see the user-side key (the Zenoh `namespace`
//     prefix is stripped before matching). Use `**/cmd` style
//     globs, NOT `<namespace>/*/cmd`.
//
//  5. Both nodes check every message against the REMOTE peer's
//     subject, so each key set is granted in both flows (see the
//     comment above `rules`).
{
  enabled: true,
  default_permission: "deny",

  // Every message is checked TWICE, once on each node, and each node
  // checks it against the REMOTE peer's subject: a put leaves the
  // publisher as `egress` and reaches the subscriber as `ingress`; a
  // subscriber declaration travels the other way. So a role is two key
  // sets, each granted in both flows:
  //
  //   publishes P: ingress put (what the role may send us) and egress
  //                declare_subscriber (whose data we may ask it for);
  //   reads     S: ingress declare_subscriber (what it may ask us for)
  //                and egress put (what we may send it).
  //
  // Granting only one flow per set leaves the two nodes disagreeing, and
  // nothing crosses: not even presence, so the peers never discover each
  // other. tests_integ/acceptance/test_two_mesh_peers_exchange_state_and_rpc.py
  // runs this file between an operator and a robot in two processes.
  rules: [
    {
      id: "robot_publishes",
      messages: ["put"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/state",
        "**/state/**",
        "**/health",
        "**/pose",
        "**/imu",
        "**/odom",
        "**/lidar/**",
        "**/hand/**",
        "**/camera/**",
        "**/stream",
        "**/response/**",
      ],
    },
    {
      id: "robot_is_asked_for",
      messages: ["declare_subscriber"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/state",
        "**/state/**",
        "**/health",
        "**/pose",
        "**/imu",
        "**/odom",
        "**/lidar/**",
        "**/hand/**",
        "**/camera/**",
        "**/stream",
        "**/response/**",
      ],
    },
    {
      // Robot reads are intentionally NARROW: only fleet-shared,
      // low-impact topic classes plus cmd/response. They deliberately do
      // NOT include `**`, `**/state/**` or `**/camera/**` - a robot has no
      // operational need to observe another robot's sensor streams.
      // Operators that need the robot to read a specific peer should route
      // through `tell`/`send` RPC, not a raw subscribe.
      id: "robot_reads",
      messages: ["declare_subscriber"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/broadcast",
        "**/safety/**",
        "**/cmd",
        "**/response/**",
      ],
    },
    {
      id: "robot_is_sent",
      messages: ["put"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/broadcast",
        "**/safety/**",
        "**/cmd",
        "**/response/**",
      ],
    },
    {
      // Operators command the fleet and announce themselves. They do not
      // publish telemetry or responses, so a robot never takes an
      // operator's word for a robot's state.
      id: "operator_publishes",
      messages: ["put"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: ["**/presence", "**/cmd", "**/broadcast", "**/safety/**"],
    },
    {
      id: "operator_is_asked_for",
      messages: ["declare_subscriber"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: ["**/presence", "**/cmd", "**/broadcast", "**/safety/**"],
    },
    {
      // INTENTIONAL operator-role privilege: operators monitor the whole
      // fleet, so they read `**`. Bound to the operator_peer subject only
      // (see policies below) - robots never reference these two rules.
      id: "operator_reads",
      messages: ["declare_subscriber"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: ["**"],
    },
    {
      id: "operator_is_sent",
      messages: ["put"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: ["**"],
    },
    {
      // The dashboard's ONLY publish grant: its own presence, so operators
      // see it on the mesh. Zenoh 1.x key_exprs cannot interpolate the
      // peer's cert CN (see the header), so this is the presence topic
      // CLASS - the role still cannot publish commands, broadcasts or
      // safety traffic, which is what makes it read-only where it matters.
      id: "dashboard_publishes",
      messages: ["put"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: ["**/presence"],
    },
    {
      id: "dashboard_is_asked_for",
      messages: ["declare_subscriber"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: ["**/presence"],
    },
    {
      // Dashboard reads are OBSERVE-ONLY: presence, health, safety events,
      // camera frames, state and rollout streams - everything a read-only
      // fleet dashboard renders. They deliberately do NOT include
      // `**/cmd`, `**/broadcast` or `**/response/**`: a dashboard has no
      // operational need to observe the command/RPC plane, and this role
      // must never be a quiet path to it.
      id: "dashboard_reads",
      messages: ["declare_subscriber"],
      flows: ["ingress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/health",
        "**/safety/**",
        "**/camera/**",
        "**/state",
        "**/state/**",
        "**/stream",
        "**/pose",
      ],
    },
    {
      id: "dashboard_is_sent",
      messages: ["put"],
      flows: ["egress"],
      permission: "allow",
      key_exprs: [
        "**/presence",
        "**/health",
        "**/safety/**",
        "**/camera/**",
        "**/state",
        "**/state/**",
        "**/stream",
        "**/pose",
      ],
    },
  ],

  subjects: [
    {
      id: "robot_peer",
      // ENUMERATE every robot's exact cert CN here.
      cert_common_names: [
        "robot-a",
        "robot-b",
        // Add more as you provision...
      ],
    },
    {
      id: "operator_peer",
      cert_common_names: [
        "op-1",
        "op-2",
        // Add more operators...
      ],
    },
    {
      id: "dashboard_peer",
      // Read-only observers: fleet dashboards, wall displays, replay
      // recorders. ENUMERATE each one's exact cert CN.
      cert_common_names: [
        "dashboard-1",
      ],
    },
  ],

  policies: [
    {
      // Robots: publish telemetry + scoped subscribe. NO blanket `**`.
      rules: ["robot_publishes", "robot_is_asked_for", "robot_reads", "robot_is_sent"],
      subjects: ["robot_peer"],
    },
    {
      // Operators: publish commands + broad observe (intentional).
      rules: ["operator_publishes", "operator_is_asked_for", "operator_reads", "operator_is_sent"],
      subjects: ["operator_peer"],
    },
    {
      // Dashboards: observe-only. May watch the fleet and announce their
      // own presence; may NOT publish commands, broadcasts or safety
      // traffic - a compromised dashboard cert can watch, not actuate.
      rules: ["dashboard_publishes", "dashboard_is_asked_for", "dashboard_reads", "dashboard_is_sent"],
      subjects: ["dashboard_peer"],
    },
  ],
}
