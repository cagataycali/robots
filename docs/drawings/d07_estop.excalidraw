 "appState": {
  "gridSize": 20,
  "gridStep": 5,
  "gridModeEnabled": false,
  "viewBackgroundColor": "#ffffff"
 },
 "files": {},
 "strandsDrawing": {
  "alt": "An e-stop runs five steps in order: engage the local lockout, stop the local robot through the same dispatch a peer would use, broadcast stop and collect replies for three seconds, publish strands/safety/estop so every peer locks itself, write the audit row. Under lockout a peer answers only status, resume and stop. Resume needs the override code of sixteen characters or more, is throttled after failures, and publishes an HMAC proof, never the code."
 }
}