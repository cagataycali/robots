   "locked": false,
   "text": "the call does not change; what refuses it does: a missing extra, a busy bus, an operator who said no.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the call does not change; what refuses it does: a missing extra, a busy bus, an operator who said no.",
   "autoResize": true,
   "lineHeight": 1.25
  }
 ],
 "appState": {
