   "link": null,
   "locked": false,
   "text": "what crosses the wire is an observation and a chunk of actions; the robot, the gate and the audit never do.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "what crosses the wire is an observation and a chunk of actions; the robot, the gate and the audit never do.",
