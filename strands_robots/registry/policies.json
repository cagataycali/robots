{
  "providers": {
    "mock": {
      "module": "strands_robots.policies.mock",
      "class": "MockPolicy",
      "description": "Sinusoidal test actions (no deps)",
      "requires": [],
      "config_keys": [
        "amplitude",
        "seed"
      ],
      "defaults": {},
      "shorthands": [
        "mock",
        "random",
        "test"
      ],
      "trainer": {
        "module": "strands_robots.training.mock",
        "class": "MockTrainer"
      }
    },
    "lerobot_local": {
      "module": "strands_robots.policies.lerobot_local",
      "class": "LerobotLocalPolicy",
      "description": "Direct HuggingFace inference (no server), incl. GR00T N1.7 (policy_type='groot')",
      "extra": "lerobot",
      "requires": [
        "pretrained_name_or_path"
      ],
      "config_keys": [
        "pretrained_name_or_path",
        "policy_type",
        "device",
        "actions_per_step",
        "norm_tag",
        "image_keys",
        "inference_action_mode",
        "embodiment",
        "strict_keys",
        "camera_key_map",
        "obs_rename_override",
        "use_processor",
        "processor_overrides",
        "tokenizer_max_length",
        "tokenizer_padding_side",
        "rtc_enabled",
        "rtc_execution_horizon",
        "rtc_max_guidance_weight",
        "inference_kwargs",
        "pad_short_actions",
        "cache_model",
        "revision",
        "compile_model"
      ],
      "defaults": {},
      "aliases": [
        "lerobot"
      ],
      "hf_orgs": [
        "lerobot",
        "allenai",
        "nvidia"
      ],
      "is_hf_default": true,
      "trainer": {
        "module": "strands_robots.training.lerobot",
        "class": "LerobotTrainer"
      }
    },
    "cosmos3": {
      "module": "strands_robots.policies.cosmos3",
      "class": "Cosmos3Policy",
      "description": "NVIDIA Cosmos 3 omnimodal VLA policy (DROID/UMI/AV/bridge/OpenArm) via Cosmos Framework",
      "requires": [],
      "config_keys": [
        "embodiment",
        "host",
        "port",
        "action_space",
        "observation_mapping",
        "action_mapping",
        "robot",
        "prompt",
        "api_key",
        "backend",
        "mode",
        "model",
        "pretrained_name_or_path",
        "actions_per_step"
      ],
      "defaults": {
        "host": "localhost",
        "port": 8000,
        "embodiment": "droid"
      },
      "shorthands": [
        "cosmos3",
        "c3"
      ],
      "url_patterns": [
        "^cosmos3://"
      ],
      "hf_orgs": [],
      "model_id_overrides": [
        "nvidia/cosmos3",
        "nvidia/cosmos3-nano-policy"
      ],
      "trainer": {
        "module": "strands_robots.training.cosmos3",
        "class": "Cosmos3Trainer"
      }
    },
    "moveit2": {
      "module": "strands_robots.policies.moveit2",
      "class": "MoveIt2Policy",
      "description": "MoveIt2 motion planning via ZMQ sidecar",
      "requires": [
        "port"
      ],
      "config_keys": [
        "host",
        "port",
        "planning_group",
        "timeout_ms",
        "api_token",
        "joint_name_map"
      ],
      "defaults": {
        "host": "127.0.0.1",
        "port": 5556,
        "planning_group": "arm"
      },
      "shorthands": [
        "moveit2"
      ],
      "aliases": [
        "moveit"
      ]
    },
    "curobo": {
      "module": "strands_robots.policies.curobo",
      "class": "CuroboPolicy",
      "description": "NVIDIA cuRobo collision-aware motion planning (in-process, CUDA)",
      "requires": [],
      "config_keys": [
        "robot_config",
        "world_config",
        "action_horizon",
        "tensor_args",
        "motion_gen_kwargs",
        "warmup",
        "device_cfg",
        "motion_planner_kwargs"
      ],
      "defaults": {
        "action_horizon": 16
      },
      "shorthands": [
        "curobo"
      ],
      "aliases": [
        "cumotion"
      ]
    },
    "wbc": {
      "module": "strands_robots.policies.wbc",
      "class": "WBCPolicy",
      "description": "NVIDIA GR00T Whole-Body-Control (SONIC) humanoid locomotion (in-process, ONNX)",
      "requires": [],
      "config_keys": [
        "checkpoint",
        "config",
        "walk",
        "target_velocity",
        "allow_missing_models"
      ],
      "defaults": {
        "walk": true
      },
      "shorthands": [
        "wbc",
        "sonic"
      ]
    },
    "wbc_gait": {
      "module": "strands_robots.policies.wbc",
      "class": "WBCGaitPolicy",
      "description": "NVIDIA GR00T Whole-Body-Control gait-clock variant (single ONNX policy, 95-dim obs + phase clock)",
      "requires": [],
      "config_keys": [
        "checkpoint",
        "config",
        "target_velocity",
        "gait_frequency",
        "allow_missing_models"
      ],
      "defaults": {},
      "shorthands": [
        "wbc_gait",
        "sonic_gait"
      ]
    },
    "wbc_latent": {
      "module": "strands_robots.policies.wbc_latent",
      "class": "WBCLatentPolicy",
      "description": "A VLA's SONIC motion tokens decoded into Unitree G1 joint targets (nvidia/GEAR-SONIC decoder, in-process ONNX) and tracked with SONIC's per-joint PD",
      "extra": "wbc",
      "requires": [],
      "config_keys": [
        "inner",
        "inner_provider",
        "inner_config",
        "checkpoint",
        "variant",
        "replan_every",
        "warn_token_abs"
      ],
      "defaults": {
        "variant": "default",
        "replan_every": 20
      },
      "shorthands": [
        "wbc_latent",
        "sonic_latent"
      ]
    },
    "kimodo": {
      "module": "strands_robots.policies.kimodo",
      "class": "KimodoPolicy",
      "description": "NVIDIA Kimodo text-to-motion diffusion for the Unitree G1 (prompt-driven kinematic motion, HuggingFace)",
      "requires": [],
      "config_keys": [
        "config",
        "model_id",
        "diffusion_steps",
        "guidance_scale",
        "num_frames",
        "transition_frames",
        "native_fps",
        "tracker_fps",
        "device",
        "dtype",
        "cache_dir",
        "trust_remote_code",
        "seed",
        "motion_agent"
      ],
      "defaults": {},
      "shorthands": [
        "kimodo",
        "kimodo_g1",
        "text2motion"
      ]
    },
    "protomotions": {
      "module": "strands_robots.policies.protomotions",
      "class": "ProtoMotionsPolicy",
      "description": "ProtoMotions Generalist Tracking Policy (ONNX, BeyondMimic-trained) for the Unitree G1 \u2014 consumes a MotionPlayer reference and emits PD joint targets",
      "requires": [],
      "config_keys": [
        "onnx_path",
        "yaml_path",
        "motion",
        "session",
        "providers",
        "history_length"
      ],
      "shorthands": [
        "protomotions",
        "gtp",
        "gtp_g1",
        "protomotions_g1"
      ]
    },
    "remote": {
      "module": "strands_robots.inference.client",
      "class": "RemotePolicy",
      "description": "Remote inference over WebSocket (WS-JSON) - forwards observations to a PolicyServer and returns action chunks",
      "requires": [],
      "config_keys": [
        "endpoint",
        "host",
        "port",
        "connect_timeout",
        "request_timeout"
      ],
      "defaults": {},
      "shorthands": [
        "remote"
      ],
      "url_patterns": [
        "^wss?://"
      ]
    },
    "rl": {
      "module": "strands_robots.policies.rl",
      "class": "RLCheckpointPolicy",
      "description": "Deterministic rollout of an RL training checkpoint's actor (policy.pt + policy_meta.json written by create_trainer('ppo'|'fast_sac'|'fast_td3'))",
      "requires": [],
      "config_keys": [
        "checkpoint_dir",
        "device"
      ],
      "defaults": {
        "device": "cpu"
      },
      "shorthands": [
        "rl"
      ]
    },
    "microduck": {
      "module": "strands_robots.policies.microduck",
      "class": "MicroduckPolicy",
      "description": "Pollen Microduck locomotion policy (ONNX, normaliser fused into the graph) for the 14-DOF open biped \u2014 self-configures from ONNX metadata, feeds obs raw, decodes DEFAULT_POSE + action*scale",
      "requires": [],
      "config_keys": [
        "onnx_path",
        "session",
        "providers",
        "command",
        "joint_names",
        "default_pose",
        "action_scale",
        "command_names"
      ],
      "shorthands": [
        "microduck",
        "microduck_walk",
        "microduck_stand"
      ]
    },
    "flux3_action": {
      "module": "strands_robots.policies.flux3_action",
      "class": "Flux3ActionPolicy",
      "description": "FLUX 3 Action (Black Forest Labs) flow-matching VLA, in-process via flux_action: 2 cameras + 8-tick history + text -> 42-step absolute joint chunk at 30 Hz; SO-101 checkpoint speaks lerobot degrees + gripper percent, UnitAdapter converts to the robot's radians",
      "requires": [],
      "config_keys": [
        "pretrained_name_or_path",
        "revision",
        "device",
        "camera_map",
        "joint_units",
        "joint_signs",
        "joint_offsets_deg",
        "gripper_range",
        "mode",
        "execute_steps",
        "task",
        "warn_outside_training_range",
        "natten_backend"
      ],
      "defaults": {
        "pretrained_name_or_path": "black-forest-labs/flux-3-action-so101",
        "device": "cuda",
        "mode": "queued",
        "execute_steps": 32
      },
      "shorthands": [
        "flux3_action",
        "flux3",
        "f3a"
      ],
      "hf_orgs": [
        "black-forest-labs"
      ],
      "model_id_overrides": []
    },
    "rsl_rl_onnx": {
      "module": "strands_robots.policies.rsl_rl_onnx",
      "class": "RslRlOnnxPolicy",
      "trainer": {
        "module": "strands_robots.training.rsl_rl",
        "class": "RslRlTrainer"
      },
      "description": "Deterministic rollout of an rsl_rl actor exported to ONNX by mjlab (metadata-driven observation rebuild; JointPositionAction decode)",
      "extra": "sim-mjlab",
      "requires": [
        "onnx_path"
      ],
      "config_keys": [
        "onnx_path",
        "command",
        "robot",
        "ee_site",
        "target"
      ],
      "defaults": {
        "ee_site": "gripper"
      },
      "shorthands": [
        "rsl_rl_onnx",
        "mjlab_onnx"
      ]
    }
  }
}
