{
  "name": "strands-robots-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "audit:screens": "node scripts/audit-screens-render.mjs",
    "audit:touch": "node scripts/audit-touch-targets.mjs",
    "audit:actions": "node scripts/audit-primary-actions.mjs",
    "audit": "node scripts/run-audits.mjs",
    "audit:keyboard": "node scripts/audit-keyboard-path.mjs",
    "audit:age": "node scripts/audit-server-age.mjs",
    "test:lib": "node scripts/run-lib-tests.mjs",
    "test": "node scripts/check-audit-guard.mjs && node scripts/run-lib-tests.mjs",
    "audit:all": "node scripts/run-audits.mjs",
    "verify": "npm run test:lib && npm run build && npm run audit:all"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
