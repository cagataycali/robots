  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.01" rgba="0.88 0.88 0.92 1"/>
    <body name="anchor_a" pos="-0.3 0 0.8">
      <geom type="sphere" size="0.04" rgba="0.3 0.3 0.3 1"/>
      <site name="sa" pos="0 0 0"/>
    </body>
    <body name="pendulum" pos="0.3 0 0.8">
      <freejoint/>
      <geom type="sphere" size="0.08" rgba="0.85 0.35 0.25 1" mass="0.5"/>
      <site name="sp" pos="0 0 0"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="rope" width="0.01" rgba="0.6 0.4 0.2 1">
      <site site="sa"/>
      <site site="sp"/>
    </spatial>
  </tendon>
  <worldbody>
    <camera name="cam" pos="1.4 -1.0 0.9" xyaxes="0.6 0.8 0 -0.3 0.25 0.92"/>
  </worldbody>
</mujoco>